<mxfile host="app.diagrams.net"><diagram name="write_path"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1217" pageHeight="2054"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Write path: PUT /buckets/{bucket}/objects/{key}&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="700" height="30" as="geometry"/></mxCell><mxCell id="lg0" value="Client / Web UI" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="110" height="20" as="geometry"/></mxCell><mxCell id="lg1" value="Nginx" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="138" y="38" width="50" height="20" as="geometry"/></mxCell><mxCell id="lg2" value="Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="196" y="38" width="62" height="20" as="geometry"/></mxCell><mxCell id="lg3" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="266" y="38" width="80" height="20" as="geometry"/></mxCell><mxCell id="lg4" value="Storage node" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="354" y="38" width="92" height="20" as="geometry"/></mxCell><mxCell id="lg5" value="Elasticsearch" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="454" y="38" width="98" height="20" as="geometry"/></mxCell><mxCell id="nc" value="&lt;b&gt;Client / Web UI&lt;/b&gt;&lt;br&gt;PUT object body&lt;br&gt;?chunking=fixed|cdc &amp;amp;tags=k=v&lt;br&gt;header X-API-Key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="220" height="109" as="geometry"/></mxCell><mxCell id="nlb" value="&lt;b&gt;Nginx&lt;/b&gt;&lt;br&gt;Forward to gateway1 or gateway2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="87" width="220" height="75" as="geometry"/></mxCell><mxCell id="nau" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;API key valid and under rate limit?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="245" y="208" width="310" height="142" as="geometry"/></mxCell><mxCell id="ne4" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Reply 401 (bad key) or 429 (too many requests)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="605" y="242" width="220" height="75" as="geometry"/></mxCell><mxCell id="ntf" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Stream body to a temp file (large files never fill RAM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="393" width="220" height="92" as="geometry"/></mxCell><mxCell id="nch" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Split file: fixed 4 MB chunks or FastCDC (rolling hash, avg 1 MB)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="393" width="220" height="92" as="geometry"/></mxCell><mxCell id="nh" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Take next chunk&lt;br&gt;chunk ID = SHA-256(content)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="514" width="220" height="92" as="geometry"/></mxCell><mxCell id="ndd" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Chunk hash already in chunks table?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="352" y="635" width="310" height="142" as="geometry"/></mxCell><mxCell id="nrf" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Dedup: refcount + 1&lt;br&gt;nothing is uploaded" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="59" y="942" width="220" height="75" as="geometry"/></mxCell><mxCell id="nmd" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Bucket mode?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="352" y="820" width="310" height="108" as="geometry"/></mxCell><mxCell id="nrg" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Hash ring (100 virtual nodes per node) gives 3 distinct live nodes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="214" y="1031" width="220" height="92" as="geometry"/></mxCell><mxCell id="npr" value="&lt;b&gt;Storage node&lt;/b&gt;&lt;br&gt;PUT /chunks/{sha256} on the 3 nodes in parallel; each node re-checks the hash" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="171" y="1166" width="220" height="109" as="geometry"/></mxCell><mxCell id="nq" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;At least W=2 nodes acknowledged?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="98" y="1395" width="310" height="125" as="geometry"/></mxCell><mxCell id="ne5" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Reply 503 write quorum failed; chunk row rolled back" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="458" y="1412" width="220" height="92" as="geometry"/></mxCell><mxCell id="nec" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;zfec Reed-Solomon: 4 data + 2 parity shares, each with its own SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="464" y="1031" width="220" height="92" as="geometry"/></mxCell><mxCell id="npe" value="&lt;b&gt;Storage node&lt;/b&gt;&lt;br&gt;PUT one share on each of 6 ring nodes (at least 5 must succeed)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="512" y="1289" width="220" height="92" as="geometry"/></mxCell><mxCell id="nlo" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Save chunk locations (replica nodes or share list)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="417" y="1563" width="220" height="75" as="geometry"/></mxCell><mxCell id="nmo" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;More chunks?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="372" y="1667" width="310" height="108" as="geometry"/></mxCell><mxCell id="nom" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Save object: bucket, key, size, version, ordered chunk list, date, tags" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="417" y="1818" width="220" height="92" as="geometry"/></mxCell><mxCell id="nov" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Overwrite? Old version&amp;#x27;s chunks: refcount - 1 (refcount 0 -&amp;gt; GC job)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="687" y="1818" width="220" height="92" as="geometry"/></mxCell><mxCell id="nes" value="&lt;b&gt;Elasticsearch&lt;/b&gt;&lt;br&gt;Index metadata in the background" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="687" y="1939" width="220" height="75" as="geometry"/></mxCell><mxCell id="nok" value="&lt;b&gt;Client / Web UI&lt;/b&gt;&lt;br&gt;200 OK {version, size, chunks, new_chunks}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="957" y="1939" width="220" height="75" as="geometry"/></mxCell><mxCell id="e0" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nc" target="nlb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nlb" target="nau"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="no" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nau" target="ne4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="yes" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nau" target="ntf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="ntf" target="nch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nch" target="nh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nh" target="ndd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="yes" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="ndd" target="nrf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="339" y="820"/></Array></mxGeometry></mxCell><mxCell id="e8" value="no" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="ndd" target="nmd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="replication" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nmd" target="nrg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nrg" target="npr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="npr" target="nq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="no" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nq" target="ne5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="yes" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nq" target="nlo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="erasure coding" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nmd" target="nec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nec" target="npe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="npe" target="nlo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="1395"/><mxPoint x="690" y="1520"/></Array></mxGeometry></mxCell><mxCell id="e17" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nrf" target="nmo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="1144"/><mxPoint x="60" y="1602"/></Array></mxGeometry></mxCell><mxCell id="e18" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nlo" target="nmo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="yes" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nmo" target="nh"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="767" y="1602"/><mxPoint x="767" y="705"/></Array></mxGeometry></mxCell><mxCell id="e20" value="no" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nmo" target="nom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="curved=1;html=1;endArrow=block;fontSize=10;label