<mxfile host="app.diagrams.net"><diagram name="read_path"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="949" pageHeight="1492"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Read path: GET /buckets/{bucket}/objects/{key}&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="700" height="30" as="geometry"/></mxCell><mxCell id="lg0" value="Client / Web UI" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="110" height="20" as="geometry"/></mxCell><mxCell id="lg1" value="Nginx" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="138" y="38" width="50" height="20" as="geometry"/></mxCell><mxCell id="lg2" value="Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="196" y="38" width="62" height="20" as="geometry"/></mxCell><mxCell id="lg3" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="266" y="38" width="80" height="20" as="geometry"/></mxCell><mxCell id="lg4" value="Storage node" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="354" y="38" width="92" height="20" as="geometry"/></mxCell><mxCell id="nc" value="&lt;b&gt;Client / Web UI&lt;/b&gt;&lt;br&gt;GET object&lt;br&gt;optional header Range: bytes=a-b" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="104" y="70" width="220" height="92" as="geometry"/></mxCell><mxCell id="nlb" value="&lt;b&gt;Nginx&lt;/b&gt;&lt;br&gt;Forward to gateway1 or gateway2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="374" y="78" width="220" height="75" as="geometry"/></mxCell><mxCell id="nau" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;API key valid and under rate limit?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="329" y="191" width="310" height="142" as="geometry"/></mxCell><mxCell id="ne4" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Reply 401 / 429" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="689" y="233" width="220" height="58" as="geometry"/></mxCell><mxCell id="nm" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Load object: size, version, ordered chunk list + each chunk&amp;#x27;s locations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="374" y="376" width="220" height="92" as="geometry"/></mxCell><mxCell id="nrn" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Range given? keep only the chunks that overlap bytes a..b (else all chunks)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="644" y="376" width="220" height="92" as="geometry"/></mxCell><mxCell id="nnx" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Take next needed chunk" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="644" y="497" width="220" height="58" as="geometry"/></mxCell><mxCell id="nmd" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Bucket mode?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="408" y="584" width="310" height="108" as="geometry"/></mxCell><mxCell id="ng" value="&lt;b&gt;Storage node&lt;/b&gt;&lt;br&gt;GET /chunks/{sha256} from a live replica; node re-hashes, 409 if corrupted" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="453" y="735" width="220" height="92" as="geometry"/></mxCell><mxCell id="nr" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Valid copy and R=2 replicas confirmed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="265" y="870" width="310" height="142" as="geometry"/></mxCell><mxCell id="nal" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Another live replica left?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="265" y="1055" width="310" height="125" as="geometry"/></mxCell><mxCell id="ne5" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Reply 503 read quorum not reached" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="1080" width="220" height="75" as="geometry"/></mxCell><mxCell id="ngs" value="&lt;b&gt;Storage node&lt;/b&gt;&lt;br&gt;GET shares from live nodes until 4 valid shares" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="177" y="744" width="220" height="75" as="geometry"/></mxCell><mxCell id="ndc" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;zfec decode 4 shares -&amp;gt; original chunk (padding removed)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="895" width="220" height="92" as="geometry"/></mxCell><mxCell id="nsl" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Cut chunk to the requested byte range" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;a