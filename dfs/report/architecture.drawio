<mxfile host="app.diagrams.net"><diagram name="architecture"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;System architecture&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="400" height="30" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;Web UI (Vue.js), curl, pytest, benchmarks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;arcSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="90" width="260" height="60" as="geometry"/></mxCell><mxCell id="gf" value="&lt;b&gt;Grafana :3001&lt;/b&gt;&lt;br&gt;DFS cluster dashboard" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e6e6e6;strokeColor=#4d4d4d;arcSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="lb" value="&lt;b&gt;Nginx :8080&lt;/b&gt;&lt;br&gt;load balancer, round robin, skips a failed gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="200" width="260" height="65" as="geometry"/></mxCell><mxCell id="pm" value="&lt;b&gt;Prometheus :9091&lt;/b&gt;&lt;br&gt;scrapes /metrics of both gateways every 10 s" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e6e6e6;strokeColor=#4d4d4d;arcSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="200" width="220" height="65" as="geometry"/></mxCell><mxCell id="gwbox" value="Gateway layer (2 instances)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f6ff;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=6;" vertex="1" parent="1"><mxGeometry x="200" y="320" width="680" height="120" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;gateway1 (FastAPI)&lt;/b&gt;&lt;br&gt;S3-like API, chunking, ring placement; runs repair + scrub loops" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="355" width="300" height="70" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;gateway2 (FastAPI)&lt;/b&gt;&lt;br&gt;same API, shares state through PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="355" width="300" height="70" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL primary&lt;/b&gt;&lt;br&gt;buckets, objects, chunks (refcount, locations), nodes, counters, rate limits" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="250" height="90" as="geometry"/></mxCell><mxCell id="pr" value="&lt;b&gt;PostgreSQL replica&lt;/b&gt;&lt;br&gt;hot standby via streaming replication; promoted on failover" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="250" height="75" as="geometry"/></mxCell><mxCell id="mq" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;queue dfs-jobs: repair, rebalance, gc" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;" vertex="1" parent="1"><mxGeometry x="415" y="500" width="250" height="65" as="geometry"/></mxCell><mxCell id="wk" value="&lt;b&gt;2 workers&lt;/b&gt;&lt;br&gt;take jobs from the queue, repair / move / delete chunks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;" vertex="1" parent="1"><mxGeometry x="415" y="630" width="250" height="70" as="geometry"/></mxCell><mxCell id="es" value="&lt;b&gt;Elasticsearch&lt;/b&gt;&lt;br&gt;search index of object metadata (bucket, key, size, date, tags)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="500" width="250" height="75" as="geometry"/></mxCell><mxCell id="sn" value="&lt;b&gt;Storage nodes node1 ... node6 (+ node7)&lt;/b&gt;&lt;br&gt;FastAPI: PUT / GET / HEAD / DELETE /chunks/{sha256}; SHA-256 checked on every read; one Docker volume per node" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="780" width="720" height="75" as="geometry"/></mxCell><mxCell id="t0" value="chunk PUT / GET&lt;br&gt;(3 replicas or 4+2 shares)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="732" y="660" width="190" height="34" as="geometry"/></mxCell><mxCell id="t1" value="heartbeat every 3 s&lt;br&gt;(id, free space, chunks)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="35" y="765" width="150" height="34" as="geometry"/></mxCell><mxCell id="e0" value="HTTP + X-API-Key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="cl" target="lb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="gf" target="pm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="lb" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="lb" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="scrape" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="pm" target="gwbox"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.12;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="gwbox" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="WAL stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="pg" target="pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="publish jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.47;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gwbox" target="mq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="mq" target="wk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gwbox" target="es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="update locations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="wk" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="repair / move / delete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wk" target="sn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.77;exitY=1;entryX=0.83;entryY=0;" edge="1" parent="1" source="gwbox" target="sn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="725" y="620"/><mxPoint x="725" y="740"/><mxPoint x="780" y="740"/></Array></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sn" target="lb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="817"/><mxPoint x="30" y="232"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>