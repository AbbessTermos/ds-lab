<mxfile host="app.diagrams.net"><diagram name="repair_path"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1305" pageHeight="1428"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Failure detection, repair, scrubbing and rebalancing&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="700" height="30" as="geometry"/></mxCell><mxCell id="lg0" value="Storage node" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="92" height="20" as="geometry"/></mxCell><mxCell id="lg1" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="120" y="38" width="80" height="20" as="geometry"/></mxCell><mxCell id="lg2" value="Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="208" y="38" width="62" height="20" as="geometry"/></mxCell><mxCell id="lg3" value="RabbitMQ / Worker" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="278" y="38" width="122" height="20" as="geometry"/></mxCell><mxCell id="lg4" value="Client / Web UI" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="408" y="38" width="110" height="20" as="geometry"/></mxCell><mxCell id="nhb" value="&lt;b&gt;Storage node&lt;/b&gt;&lt;br&gt;Every 3 s: heartbeat (id, free space, chunk count) via Nginx" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" vertex="1" parent="1"><mxGeometry x="467" y="199" width="220" height="92" as="geometry"/></mxCell><mxCell id="nup" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;nodes table: last_seen = now" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="467" y="359" width="220" height="75" as="geometry"/></mxCell><mxCell id="nnw" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;New node id?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="422" y="463" width="310" height="108" as="geometry"/></mxCell><mxCell id="nrb" value="&lt;b&gt;RabbitMQ / Worker&lt;/b&gt;&lt;br&gt;Publish a rebalance job per replicated chunk" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="622" width="220" height="75" as="geometry"/></mxCell><mxCell id="nlp" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;gateway1 repair loop every 5 s" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="757" y="70" width="220" height="75" as="geometry"/></mxCell><mxCell id="ndn" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Any node with no heartbeat for 10 s?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="712" y="174" width="310" height="142" as="geometry"/></mxCell><mxCell id="nmd" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Node marked DOWN (UI, /status, Grafana)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="757" y="359" width="220" height="75" as="geometry"/></mxCell><mxCell id="ndg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Find degraded chunks: fewer than 3 live replicas or 6 live shares" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="757" y="471" width="220" height="92" as="geometry"/></mxCell><mxCell id="npj" value="&lt;b&gt;RabbitMQ / Worker&lt;/b&gt;&lt;br&gt;Publish one repair job per degraded chunk to queue dfs-jobs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="614" width="220" height="92" as="geometry"/></mxCell><mxCell id="nwk" value="&lt;b&gt;RabbitMQ / Worker&lt;/b&gt;&lt;br&gt;Worker takes a job and reloads the chunk&amp;#x27;s locations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="509" y="752" width="220" height="92" as="geometry"/></mxCell><mxCell id="nty" value="&lt;b&gt;RabbitMQ / Worker&lt;/b&gt;&lt;br&gt;Job type?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="464" y="903" width="310" height="108" as="geometry"/></mxCell><mxCell id="nrr" value="&lt;b&gt;RabbitMQ / Worker&lt;/b&gt;&lt;br&gt;Replication: read a healthy copy, PUT it on the next ring nodes until 3 copies" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="755" y="1054" width="220" height="109" as="geometry"/></mxCell><mxCell id="nre" value="&lt;b&gt;RabbitMQ / Worker&lt;/b&gt;&lt;br&gt;Erasure coding: read 4 shares, decode, re-encode the missing shares, PUT on other nodes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1054" width="220" height="109" as="geometry"/></mxCell><mxCell id="nmv" value="&lt;b&gt;RabbitMQ / Worker&lt;/b&gt;&lt;br&gt;Rebalance: copy chunk to its new ring owners, delete it from old ones" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="265" y="1062" width="220" height="92" as="geometry"/></mxCell><mxCell id="ngc" value="&lt;b&gt;RabbitMQ / Worker&lt;/b&gt;&lt;br&gt;GC: delete chunks whose refcount reached 0" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1071" width="220" height="75" as="geometry"/></mxCell><mxCell id="nul" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Update locations; count repaired chunks and repair bytes read / written" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="509" y="1192" width="220" height="92" as="geometry"/></mxCell><mxCell id="nsc" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Scrubber every 5 min (or POST /admin/scrub): re-read every stored copy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="614" width="220" height="92" as="geometry"/></mxCell><mxCell id="nvf" value="&lt;b&gt;Storage node&lt;/b&gt;&lt;br&gt;SHA-256 still matches?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="955" y="735" width="310" height="125" as="geometry"/></mxCell><mxCell id="nbd" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Bit rot: delete bad copy, remove it from locations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="920" width="220" height="75" as="geometry"/></mxCell><mxCell id="nrp" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;Rebuild from a healthy copy / 4 shares" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="1071" width="220" height="75" as="geometry"/></mxCell><mxCell id="nok" value="&lt;b&gt;Client / Web UI&lt;/b&gt;&lt;br&gt;Degraded objects back to 0" style="rounded=1;whiteSpace=wrap;