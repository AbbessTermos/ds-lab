1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="npj" target="nwk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nwk" target="nty"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="repair (rep)" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nty" target="nrr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="repair (ec)" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nty" target="nre"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="252" y="1054"/></Array></mxGeometry></mxCell><mxCell id="e12" value="rebalance" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nty" target="nmv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="gc" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nty" target="ngc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nrr" target="nul"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="curved=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="nre" target="nul"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoi